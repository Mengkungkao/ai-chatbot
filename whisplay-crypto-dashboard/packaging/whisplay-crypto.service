# Autostart unit for the Whisplay Bitcoin Market Dashboard.
# Installed by install.sh --autostart, which substitutes the placeholders.
[Unit]
Description=Whisplay Bitcoin Market Dashboard
Documentation=file://__APP_DIR__/README.md
# The daemon owns the LCD and button, so it must be up first.
After=network-online.target whisplay-daemon.service
Wants=network-online.target
# Follow the daemon: if it stops, this app has no display to draw on.
BindsTo=whisplay-daemon.service

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=audio video gpio input spi
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/run.sh
Environment=HOME=__USER_HOME__
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/__UID__

# Survive crashes without human intervention -- but NOT a deliberate exit.
#
# Restart=always would fight the daemon: long-pressing to leave the app
# would simply bring it back 5s later and steal the screen from the
# desktop, making the exit gesture useless on a multi-app device.
# on-failure keeps the crash-recovery requirement while letting the user
# actually return to the Whisplay desktop.
# Set this to "always" if the Pi is a dedicated, single-purpose BTC display.
Restart=on-failure
RestartSec=5
# Do not give up after repeated restarts -- a 24/7 appliance must keep trying.
StartLimitIntervalSec=0

# Keep the footprint bounded on a 512 MB Pi Zero 2 W.
MemoryMax=180M
Nice=5

[Install]
WantedBy=multi-user.target
