# Copy to .env and fill in only what you actually use.
# The dashboard runs fully on free, key-less endpoints by default --
# no key is required for Binance, CoinGecko public, or alternative.me.

# Optional: CoinGecko Pro / Demo key. Raises rate limits.
# COINGECKO_API_KEY=

# Optional: use the Pro host instead of the public one.
# Leave unset for the free public API.
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# Optional: CoinMarketCap key, for a future CMC provider.
# COINMARKETCAP_API_KEY=

# Optional: override the Binance host (e.g. a regional mirror).
# BINANCE_API_BASE=https://api.binance.com

# Optional: point the app at a different config file.
# WHISPLAY_CRYPTO_CONFIG=/home/pi/whisplay-crypto-dashboard/config.yaml
